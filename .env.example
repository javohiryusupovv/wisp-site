# Public site URL (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://wisp-mac.vercel.app

# Lemon Squeezy → Settings → Webhooks: URL https://<site>/api/lemonsqueezy, events order_created + order_refunded
LEMONSQUEEZY_WEBHOOK_SECRET=

# GitHub org that owns the private repos, and a token of an org owner (classic: admin:org; fine-grained: Members read/write)
GITHUB_ORG=wisp-widgets
GITHUB_TOKEN=

# Lemon Squeezy product IDs → GitHub team slugs (each team has Read access to its repo)
PRODUCT_MAC_ID=1413358
TEAM_MAC=mac-buyers
PRODUCT_WINDOWS_ID=1413366
TEAM_WINDOWS=windows-buyers
